<Window x:Class="GameHook.OverlayEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Overlay Editor" Height="800" Width="1200"
        Loaded="MainWindow_Loaded"
        KeyDown="MainWindow_KeyDown"
        FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1E1E">

    <DockPanel>
        <!-- 🧭 Top Toolbar -->


        <ToolBar DockPanel.Dock="Top" Margin="5">
            <Separator />
            <Label x:Name="MapperNameLabel"
       Content="Game: (Loading...)"
       FontWeight="Bold"
       FontSize="14"
       Margin="10,0,20,0"
       VerticalAlignment="Center" />
            <Separator />
            <Button Content="Create" Click="CreateOverlay_Click" HorizontalAlignment="Left" />
            <Button Content="Save" Click="SaveOverlay_Click" Margin="5,0,0,0"/>
            <Button Content="Save As" Click="SaveAsOverlay_Click" Margin="5,0,0,0"/>
            <Button Content="Load" Click="LoadOverlay_Click" Margin="5,0,0,0"/>
            <Button Content="Clone" Click="CloneOverlay_Click" Margin="5,0,0,0"/>
            <Button Content="Delete" Click="DeleteOverlay_Click" Margin="5,0,0,0"/>
            <Button Content="Undo" Click="Undo_Click" Margin="5,0,0,0"/>
            <Button Content="Redo" Click="Redo_Click" Margin="5,0,0,0"/>

            <Button Content="View Mapper Values" Click="ViewMapperValues_Click" Margin="20,0,0,0"/>

        </ToolBar>



        <!-- 🧰 Left Sidebar -->
        <DockPanel DockPanel.Dock="Left" Width="250" Background="#FF2B2B2B">
            <!-- Toolbox -->
            <StackPanel Background="#FF3A3A3A" Margin="10">
                <TextBlock Text="Toolbox" Foreground="White" FontWeight="Bold" Margin="0 0 0 8"/>
                <Button Content="🅣  Text" Click="Toolbox_AddText_Click" Margin="0 4"/>
                <Button Content="⬛  Rectangle" Click="Toolbox_AddShape_Click" Margin="0 4"/>
                <!-- Add more tools here -->
            </StackPanel>

            <Separator Height="1" Background="Gray" Margin="0 8"/>

            <!-- Layer Manager -->
            <StackPanel Background="#FF3A3A3A" Margin="10" DockPanel.Dock="Bottom">
                <TextBlock Text="Layers" Foreground="White" FontWeight="Bold" Margin="0 0 0 8"/>
                <ListBox x:Name="LayerList" Height="300" Background="#FF4A4A4A" Foreground="White"/>
                <!-- Context menu, reordering etc will go here later -->
            </StackPanel>
        </DockPanel>

        <!-- 🎨 Zoomable & Scaled Preview Canvas -->
        <Grid Grid.Column="1" Background="#FF1E1E1E">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="127*"/>
                <ColumnDefinition Width="823*"/>
            </Grid.ColumnDefinitions>

            <!-- Viewbox keeps the canvas scaled -->
            <Viewbox Name="CanvasViewbox"
             Stretch="Uniform"
             HorizontalAlignment="Left"
             VerticalAlignment="Top"
             Margin="0,20,0,0" Grid.ColumnSpan="2">
                <Canvas Name="PreviewCanvas"
                Width="1920"
                Height="1080"
                MouseLeftButtonDown="PreviewCanvas_MouseLeftButtonDown"
                Background="#FF505050"
                        />
            </Viewbox>

            <!-- Placeholder UI panel underneath for selected element details -->
            <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="0,559,0,0"
                Height="171" Width="950" Grid.ColumnSpan="2">
                <TextBlock Text="Canvas Size:" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="ResolutionDropdown" Width="150" SelectedIndex="0" Height="24">
                    <ComboBoxItem Content="1920x1080"/>
                    <ComboBoxItem Content="1280x720"/>
                    <ComboBoxItem Content="1600x900"/>
                    <ComboBoxItem Content="1024x576"/>
                </ComboBox>
                <Button Content="Apply" Click="ApplyResolution_Click" Margin="10,0,0,0" Height="22"/>
                <TextBlock Text="🔍 No element selected"
                   Foreground="White"
                   FontSize="14"
                   VerticalAlignment="Center"/>
                <!-- You'll add live details here dynamically later -->
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
