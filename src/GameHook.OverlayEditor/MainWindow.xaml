<Window x:Class="GameHook.OverlayEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Overlay Editor"
        Height="720"
        Width="1280"
        Background="#1e1e1e">

    <DockPanel>
        <!-- Top Toolbar -->
        <ToolBar DockPanel.Dock="Top" Background="#333">
            <Button Content="Open Preview" Click="OpenPreview_Click" Padding="8,2" Margin="4"/>
            <!-- More toolbar buttons will go here -->
        </ToolBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <!-- Layers list -->
                <ColumnDefinition Width="*"/>
                <!-- Main editing area -->
            </Grid.ColumnDefinitions>

            <!-- Layers Sidebar -->
            <Border Background="#2d2d30" Margin="4" Grid.Column="0">
                <StackPanel Margin="10">
                    <TextBlock Text="Layers" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0 0 0 10"/>
                    <ListBox Name="LayersListBox" Background="#1e1e1e" Foreground="White"/>
                </StackPanel>
            </Border>

            <!-- Editor Workspace -->
            <Border Background="#252526" Margin="4" Grid.Column="1">
                <Grid>
                    <!-- You can build your future element editor here -->
                    <TextBlock Text="Editor Workspace" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
